# ============================================================================
# Club Manager — client/.env
# ============================================================================
# Copy to .env and fill in real values. Vite only reads env vars prefixed
# with VITE_, so keep that prefix.
#
# All public values (anon key is safe to expose to the browser — that's its job).
# ============================================================================

# Backend API base URL
VITE_BACKEND_URL=http://localhost:8080

# Supabase project
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key-from-supabase-dashboard>
