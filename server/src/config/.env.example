# ============================================================================
# Club Manager — server/.env (production)  and  server/.env.dev (development)
# ============================================================================
#
# HOW TO USE
# - Copy this file to .env (prod) or .env.dev (dev) in the SAME directory.
# - Replace every <...> placeholder with a real value.
# - NEVER commit .env or .env.dev to git. They are already in .gitignore.
# - Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# HOW THIS FILE IS LOADED
#   config.js uses `process.loadEnvFile(...)` (Node 20+), so the right file
#   is picked based on NODE_ENV. No `dotenv` package needed.
#
# ============================================================================
# RUNTIME
# ============================================================================
NODE_ENV=prod
# PORT=8080

# ============================================================================
# CORS — frontend URLs (the server's CORS allowlist)
# ============================================================================
CLIENT_PROD_URL=https://club-manager-client.example.com
ADMIN_PROD_URL=https://club-manager-admin.example.com
CLIENT_DEV_URL=http://localhost:5173
ADMIN_DEV_URL=http://localhost:5174

# ============================================================================
# AUTH — JWT secret
# ============================================================================
# 32+ chars random. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<paste-a-32-byte-random-hex-string-here>

# ============================================================================
# DATABASE — MongoDB Atlas (legacy, current stack)
# ============================================================================
# Connection string from Atlas → Connect → Drivers → Node.js
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clubmanager?retryWrites=true&w=majority

# ============================================================================
# EMAIL — Gmail (used by reservation notifications, password recovery, etc.)
# ============================================================================
# Gmail "App Password" — NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA enabled).
SERVICE=gmail
GMAILPORT=465
GMAILUSER=<your-club-gmail>@gmail.com
GMAILPASS=<16-char-app-password>

# ============================================================================
# DATABASE — Supabase (target stack, NOT YET WIRED IN)
# ============================================================================
# These are read by server/src/config/supabaseClient.js. They are safe to
# leave blank until the Supabase migration is applied (see migracion/00_CHECKLIST.md).
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role-key-from-supabase-dashboard>
# SUPABASE_ANON_KEY=<anon-public-key-from-supabase-dashboard>
